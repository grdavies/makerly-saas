{
  "name": "makerly-saas",
  "version": "0.1.0",
  "description": "Makerly - Inventory Management SaaS Platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean",
    "db:migrate": "./scripts/db-migrate.sh migrate",
    "db:rollback": "./scripts/db-migrate.sh rollback",
    "db:status": "./scripts/db-migrate.sh status",
    "db:types": "./scripts/db-migrate.sh types",
    "db:new": "./scripts/db-migrate.sh new",
    "db:diff": "./scripts/db-migrate.sh diff",
    "db:reset": "./scripts/db-migrate.sh reset",
    "db:seed": "./scripts/db-migrate.sh seed",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:link": "./scripts/db-migrate.sh link",
    "db:validate": "./scripts/validate-migrations.sh --all",
    "db:test-rls": "./scripts/test-rls-policies.sh test",
    "setup:env": "./scripts/setup-env.sh",
    "setup": "pnpm setup:env && pnpm install",
    "prepare": "husky"
  },
  "workspaces": [
    "web",
    "docs",
    "marketing",
    "shared",
    "emails"
  ],
  "devDependencies": {
    "@nuxt/test-utils": "^3.8.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/ui": "^4.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "resend": "^6.2.2",
    "supabase": "^1.200.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.3",
    "vue-email": "^0.8.11"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "lint-staged": {
    "web/**/*.{js,ts,vue}": [
      "cd web && eslint --fix",
      "prettier --write"
    ],
    "docs/**/*.{js,ts,vue}": [
      "cd docs && eslint --fix",
      "prettier --write"
    ],
    "marketing/**/*.{js,ts,vue}": [
      "cd marketing && eslint --fix",
      "prettier --write"
    ],
    "emails/**/*.{js,ts,vue}": [
      "cd emails && eslint --fix",
      "prettier --write"
    ],
    "*.{js,ts,vue}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
