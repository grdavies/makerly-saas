{
  "name": "makerly-saas",
  "version": "0.1.0",
  "description": "Makerly - Inventory Management SaaS Platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "pnpm -r test:e2e",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:rollback": "pnpm --filter web db:rollback",
    "db:status": "pnpm --filter web db:status",
    "db:types": "pnpm --filter web db:types"
  },
  "workspaces": [
    "web",
    "docs",
    "marketing",
    "shared",
    "emails"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "dependencies": {
    "vue": "^3.4.0"
  }
}
